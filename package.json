{
  "name": "minimail",
  "version": "0.1.0-rc.14",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "admin:create": "node server/create-admin.js",
    "db:migrate": "node server/migrate-sqlite.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "format": "prettier --write src server tests vite.config.js"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fullcalendar/core": "6.1.20",
    "@fullcalendar/daygrid": "6.1.20",
    "@fullcalendar/interaction": "6.1.20",
    "@fullcalendar/list": "6.1.20",
    "@fullcalendar/luxon3": "6.1.20",
    "@fullcalendar/react": "6.1.20",
    "@fullcalendar/timegrid": "6.1.20",
    "@touch4it/ical-timezones": "1.9.0",
    "d3-geo": "^3.1.1",
    "express": "^5.1.0",
    "fast-xml-parser": "5.11.2",
    "ical.js": "2.2.1",
    "imapflow": "^1.0.195",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "luxon": "3.7.2",
    "mailparser": "^3.9.0",
    "maxmind": "^5.0.7",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.7",
    "openpgp": "^6.3.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "vite": "^7.0.0"
  },
  "license": "Apache-2.0"
}
