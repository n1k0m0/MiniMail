# Required in production. Generate once with: openssl rand -hex 32
# Keep this key with your encrypted database backups. Never rotate it by editing this file.
APP_ENCRYPTION_KEY=
# Generate distinct values with openssl rand -hex 32. Never commit real passwords.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Outside Docker, set MYSQL_HOST=127.0.0.1 (and optionally MYSQL_PORT,
# MYSQL_DATABASE and MYSQL_USER). Compose sets these automatically.
# Optional for compose.vpn.yaml; actual profiles and targets stay outside Git.
# VPN_CONFIG_DIR=./local/vpn
# VPN_TARGETS_FILE=./local/vpn-targets.json
# MAIL_VPN_PROFILE_ID=private
# MAIL_VPN_PROFILE_LABEL=Private mail VPN
# Optional for compose.geoip.yaml: a local City MMDB database.
# GEOIP_DB_FILE=./local/geoip.mmdb
# Optional: exact hostnames allowed for calendars on private networks.
# Public HTTPS calendars need no allowlist. Never use wildcards.
# CALENDAR_ALLOWED_HOSTS=calendar.internal.example
